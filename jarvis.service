[Unit]
Description=Jarvis Voice Assistant for Claude Code
After=sound.target

[Service]
Type=simple
WorkingDirectory=@@JARVIS_DIR@@
ExecStart=@@JARVIS_DIR@@/jarvis.sh
SyslogIdentifier=jarvis
Restart=on-failure
RestartSec=5
Environment=PATH=/home/dxue/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
